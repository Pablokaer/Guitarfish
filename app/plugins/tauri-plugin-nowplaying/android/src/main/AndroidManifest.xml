<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Solos view listens through the microphone for the song's key (WebView getUserMedia). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Solos can draw the scale over the camera picture of the guitar (WebView getUserMedia). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application>
        <!--
          Declaring a NotificationListenerService is what lets the user grant
          "Notification access" to the app, which in turn unlocks
          MediaSessionManager.getActiveSessions() for other apps (Spotify).
          The service itself does nothing with notifications.
        -->
        <service
            android:name="com.tabsync.nowplaying.NowPlayingListenerService"
            android:label="Guitarfish now playing"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
