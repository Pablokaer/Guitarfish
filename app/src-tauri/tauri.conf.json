{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Guitarfish",
  "version": "0.7.2",
  "identifier": "com.tabsync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Guitarfish",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 420,
        "label": "main",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5NTc1QjREOTYyQzZCQUEKUldTcWF5eVdUVnRYdVNnT1NWSjg1ZVhyZno2dFR0ajB0NnV5cVdnNWpaSkdKQldkdzBpakV2NnoK",
      "endpoints": [
        "https://github.com/Pablokaer/Guitarfish/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
